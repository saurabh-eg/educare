  <main class="page-wrapper">

    {{>navbar}}

    <section class="logen">
      <div class="contact-col">

        <h2>Sign Up</h2>
        <form action="/api/v1/users/register" method="POST" id="signupForm">
          <input type="text" name="name" placeholder="Enter Your Name">
          <input type="Email" name="email" placeholder="Enter Email">
          <input type="number" name="contact" placeholder="Enter Contact number">
          <input type="text" name="course" placeholder="Enter Course Type">
          <input type="password" name="password" placeholder="Create  Password">
          <input type="password" name="confirmPassword" placeholder="Confirm Password">
          <button type="Sibmit" class="cont-Button">SIGN UP</button>
        </form>
        <h5>Already have an account yet?<a href="/login"><span>Log in</span></a></h5>
      </div>

      <div class="popup" id="popup">

        <img src="https://cdn-icons-png.flaticon.com/128/5610/5610944.png" alt="">
        <h2>Thank You!</h2>
        <p>Your details has been successfully submitted. Thanks!</p>
        <button onclick="closePopup()">Back to Home</button>


      </div>
    </section>








